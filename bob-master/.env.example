# Copy to .env for local dev. Real values live only on the source Mac mini today
# (see docs/SECRETS_AND_INTEGRATIONS_MAP.md) or in Railway's env var store in prod
# — never commit a filled-in .env. Names only below.

# --- Persistence (Railway provisions this automatically for its Postgres add-on) ---
DATABASE_URL=postgresql://user:password@localhost:5432/bob

# --- GHL ---
GHL_API_KEY=pit-...
GHL_LOCATION_ID=...

# --- ClickUp ---
CLICKUP_API_TOKEN=...

# --- Slack ---
# See app/integrations/slack.py — a bot token (xoxb) cannot call Slack's search
# API. Decide with Chris/Jaime whether this needs a user token instead before
# porting the cancel-intent / new-channel-detection logic.
SLACK_BOT_TOKEN=xoxb-...

# --- Google (service account, shared as Viewer on each heartbeat sheet) ---
# Base64-encoded JSON key content, not raw JSON and not a file path. Raw JSON pasted
# into Railway's variable editor has been observed getting truncated/mangled — base64
# is plain alphanumeric text, nothing for a web form to misinterpret.
# Generate with: base64 -i service-account.json | tr -d '\n' | pbcopy   (macOS)
#                base64 -w0 service-account.json                        (Linux)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsIC4uLn0=
